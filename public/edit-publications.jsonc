// Hand edits, applied by scripts/fetch_scholar.py after each fetch.
// Refer to a paper by its DOI ("10.1234/abcd") or by its exact title.
{
  // Papers to leave off the page
  "hide": [
    // "10.1234/abcd",
  ],

  // Corrections to individual fields: title, authors, year, journal, abstract, url
  "fix": {
    // "10.1234/abcd": { "journal": "Correct Journal Name" },
  },

  // Papers not on anyone's Scholar profile
  "add": [
    // {
    //   "title": "Paper title",
    //   "authors": ["Samuel Pironon", "Co Author"],
    //   "year": 2024,
    //   "journal": "Journal name",
    //   "url": "https://doi.org/10.1234/abcd",
    //   "abstract": ""
    // },
  ],
}
