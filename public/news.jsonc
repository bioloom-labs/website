/* News entries for the News page.
   Each entry is one row on the timeline, latest first. Order here doesn't
   matter — entries are sorted by date, newest first, and anything dated ahead
   of today is flagged "Upcoming". Clicking a row (or one of its pictures)
   opens a window with the full image set and write-up.

   Fields:
     id      – optional stable key; falls back to title + position
     date    – YYYY-MM-DD
     title   – headline
     tag     – short label. It rides the split-flap board next to the date and
               picks the entry's accent hue. Known tags: Publication, Preprint,
               Open Data, Dataset, Talk, Event, Award, Press, Fieldwork,
               People. Anything else still works and gets a colour by position.
               Keep it short — every character is a flap.
     text    – 1–2 sentence teaser shown on the row
     body    – optional array of paragraphs for the window; falls back to `text`
     images  – any number. The row shows them on a flip board of unevenly sized
               tiles — up to four, or three on alternate rows. Tiles keep
               turning over and no two ever show the same picture: with more
               pictures than tiles a tile turns to one waiting off the board,
               and with exactly as many, two tiles trade places instead. One
               picture means a still tile; five or six give the liveliest
               board. The window shows them all in a gallery.
               Each: { src, alt, credit?: { name, url } }
               A bare string is accepted as shorthand for { src }.
               Entries with no images render as a full-width text row.
     link    – optional { url, label } — or a bare URL string
*/
[
  {
    "id": "lab-day-out-kew-2026",
    "date": "2026-04-29",
    "title": "Lab Day Out at Kew",
    "tag": "Event",
    "text": "The group spent a day at Kew Gardens, walking the lake crossing, the glasshouses and the spring planting.",
    "body": [
      "The group spent 29 April at the Royal Botanic Gardens, Kew — a day away from screens, walking the grounds together at the height of the spring flowering."
    ],
    "images": [
      {
        "src": "/news/29-04-2026/kew-1.webp",
        "alt": "Group walking away from the camera along a low bronze-railed bridge over water, towards a large tree in new leaf under a clear blue sky"
      },
      {
        "src": "/news/29-04-2026/kew-2.webp",
        "alt": "Two people standing beneath the spreading trunks of a large rhododendron in full pink flower, with fallen petals covering the ground"
      },
      {
        "src": "/news/29-04-2026/kew-3.webp",
        "alt": "Three people on a metal walkway inside a Victorian glasshouse, looking up at palms and tree ferns"
      },
      {
        "src": "/news/29-04-2026/kew-4.webp",
        "alt": "Four people sitting on a bench beyond a meadow of tulips in pink, red, orange and near-black, growing up through long grass"
      },
      {
        "src": "/news/29-04-2026/kew-5.webp",
        "alt": "Four people walking a shaded path towards a bank of pink and lilac rhododendrons in flower"
      },
      {
        "src": "/news/29-04-2026/kew-6.webp",
        "alt": "Five people standing together at the far end of a long bronze-railed bridge over a still lake, backed by tall conifers"
      }
    ]
  }
]
